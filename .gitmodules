[submodule ".registry"]
	path = .registry
	url = https://github.com/igraph/igraph.r-universe.dev
	branch = HEAD
[submodule "igraph"]
	path = igraph
	url = https://github.com/igraph/rigraph
[submodule "igraph.dev"]
	path = igraph.dev
	url = https://github.com/igraph/rigraph
	branch = main-green
[submodule "igraphdata"]
	path = igraphdata
	url = https://github.com/igraph/igraphdata
